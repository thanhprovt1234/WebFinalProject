<%@ page pageEncoding="UTF-8" %>
  </main>

  <c:choose>
    <c:when test="${bodyClass == 'auth-page'}">
      <footer class="auth-bottom">
        <p>Tinh giản. Tự tin. Là chính bạn.</p>
        <span>&copy; 2026 H2T Menswear</span>
      </footer>
    </c:when>
    <c:otherwise>
  <footer class="site-footer">
    <div class="container app-container">
      <div class="footer-main">
        <div>
          <a class="brand-lockup footer-brand" href="${pageContext.request.contextPath}/" aria-label="H2T - Trang chủ">
            <span class="brand-mark" aria-hidden="true">H2T</span>
            <span class="brand-name">Menswear</span>
          </a>
          <p class="footer-copy">Thời trang nam hiện đại, tinh gọn và vừa vặn với nhịp sống mỗi ngày.</p>
        </div>
        <nav class="footer-links" aria-label="Liên kết cuối trang">
          <a href="${pageContext.request.contextPath}/">Trang chủ</a>
          <a href="${pageContext.request.contextPath}/#collection">Bộ sưu tập</a>
          <c:if test="${empty pageContext.request.userPrincipal}">
            <a href="${pageContext.request.contextPath}/login">Đăng nhập</a>
            <a href="${pageContext.request.contextPath}/register">Tạo tài khoản</a>
          </c:if>
        </nav>
      </div>
      <div class="footer-bottom">
        <span>&copy; 2026 H2T Menswear</span>
        <span>Thiết kế cho trải nghiệm mua sắm hiện đại.</span>
      </div>
    </div>
  </footer>
    </c:otherwise>
  </c:choose>

  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
    crossorigin="anonymous"
  ></script>
  <script src="${pageContext.request.contextPath}/js/app.js"></script>
</body>
</html>
