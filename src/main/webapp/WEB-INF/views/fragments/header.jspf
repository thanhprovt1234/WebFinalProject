<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="${_csrf.token}">
  <meta name="csrf-header" content="${_csrf.headerName}">
  <meta name="description" content="${pageDescription}">
  <title><c:out value="${pageTitle}" /> | H2T</title>
  <link
    href="${pageContext.request.contextPath}/css/vendor/bootstrap.min.css"
    rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
    crossorigin="anonymous"
  >
  <link
    href="${pageContext.request.contextPath}/css/vendor/bootstrap-icons.min.css"
    rel="stylesheet"
  >
  <link href="${pageContext.request.contextPath}/css/app.css" rel="stylesheet">
  <link href="${pageContext.request.contextPath}/css/fashion-theme.css" rel="stylesheet">
  <link href="${pageContext.request.contextPath}/css/product-activity.css" rel="stylesheet">
  <c:if test="${bodyClass == 'profile-page'}"><link href="${pageContext.request.contextPath}/css/profile.css" rel="stylesheet"></c:if>
  <c:if test="${bodyClass == 'catalog-page' || bodyClass == 'product-page' || bodyClass == 'home-page'}">
    <link href="${pageContext.request.contextPath}/css/catalog.css" rel="stylesheet">
  </c:if>
  <c:if test="${bodyClass == 'product-page'}">
    <link href="${pageContext.request.contextPath}/css/product-detail.css" rel="stylesheet">
  </c:if>
</head>
<body class="${bodyClass}">
  <a class="skip-link" href="#main-content">Đi đến nội dung chính</a>

  <div class="announcement">H2T MENSWEAR <span> / </span> ĐƠN GIẢN ĐỂ KHÁC BIỆT</div>
  <nav class="navbar navbar-expand-lg site-navbar sticky-top" aria-label="Điều hướng chính">
    <div class="container app-container">
      <a class="navbar-brand brand-lockup" href="${pageContext.request.contextPath}/" aria-label="H2T - Trang chủ">
        <span class="brand-mark" aria-hidden="true">H2T</span>
        <span class="brand-name">Menswear</span>
      </a>

      <c:choose>
        <c:when test="${bodyClass == 'auth-page'}">
          <a class="back-home" href="${pageContext.request.contextPath}/">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Về trang chủ
          </a>
        </c:when>
        <c:otherwise>
      <button
        class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#mainNavigation"
        aria-controls="mainNavigation"
        aria-expanded="false"
        aria-label="Mở menu"
      >
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="mainNavigation">
        <ul class="navbar-nav mx-auto mb-3 mb-lg-0">
          <li class="nav-item">
            <a class="nav-link nav-new" href="${pageContext.request.contextPath}/collections">SẢN PHẨM</a>
          </li>
          <li class="nav-item category-dropdown">
            <button class="nav-link category-toggle" type="button" aria-expanded="false" aria-controls="nav-shirts">DANH MỤC <i class="bi bi-chevron-down" aria-hidden="true"></i></button>
            <ul class="category-submenu" id="nav-shirts" hidden>
              <c:forEach var="category" items="${catalogCategories}"><li><a class="category-menu-link" href="${pageContext.request.contextPath}/collections?category=${category.id}"><c:out value="${category.name}" /></a></li></c:forEach>
            </ul>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="${pageContext.request.contextPath}/#about">VỀ H2T</a>
          </li>
        </ul>

        <div class="nav-actions">
          <c:choose>
            <c:when test="${not empty pageContext.request.userPrincipal}">
              <a class="user-chip" href="${pageContext.request.contextPath}/profile" aria-label="Thông tin tài khoản và địa chỉ nhận hàng">
                <i class="bi bi-person-circle" aria-hidden="true"></i>
                <c:out value="${pageContext.request.userPrincipal.name}" />
              </a>
              <form action="${pageContext.request.contextPath}/logout" method="post" class="m-0">
                <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
                <button type="submit" class="btn btn-outline-dark btn-sm rounded-pill px-3">Đăng xuất</button>
              </form>
            </c:when>
            <c:otherwise>
              <a class="nav-login" href="${pageContext.request.contextPath}/login"><i class="bi bi-person" aria-hidden="true"></i> Đăng nhập</a>
              <a class="btn btn-primary btn-sm px-3" href="${pageContext.request.contextPath}/register">
                Đăng ký
              </a>
            </c:otherwise>
          </c:choose>
          <button type="button" class="nav-cart" data-open-cart aria-label="Giỏ hàng, 0 sản phẩm" aria-haspopup="dialog" aria-controls="cart-dialog">
            <i class="bi bi-bag" aria-hidden="true"></i><span class="nav-cart-count" data-cart-count aria-hidden="true">0</span>
          </button>
        </div>
      </div>
        </c:otherwise>
      </c:choose>
    </div>
  </nav>

  <main id="main-content" class="site-main">
