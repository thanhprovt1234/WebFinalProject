<%@ page pageEncoding="UTF-8" %>
<dl class="order-metadata">
  <div><dt>Mã đơn hàng:</dt><dd>#<c:out value="${order.code}" /></dd></div>
  <div><dt>Ngày đặt:</dt><dd><c:out value="${order.placedAt}" /></dd></div>
  <div><dt>Trạng thái:</dt><dd><c:out value="${order.statusLabel}" /></dd></div>
  <div><dt>Hình thức thanh toán:</dt><dd><c:out value="${order.paymentMethod == 'COD' ? 'Thanh toán khi nhận hàng' : order.paymentMethod}" /></dd></div>
  <div><dt>Trạng thái thanh toán:</dt><dd><c:out value="${order.paymentStatusLabel}" /></dd></div>
</dl>
<section class="order-address"><h3><i class="bi bi-geo-alt" aria-hidden="true"></i> Địa chỉ giao hàng</h3><div class="order-address-card"><strong><c:out value="${order.receiverName}" /></strong><p><c:out value="${order.receiverPhone}" /></p><p><c:out value="${order.shippingAddress}" /></p></div></section>
<section class="order-detail-products"><h3><i class="bi bi-bag" aria-hidden="true"></i> Sản phẩm đã đặt</h3><c:forEach var="shop" items="${order.shops}"><div class="order-card-shop"><strong><c:out value="${shop.name}" /></strong><span class="order-badge" data-status="${shop.status}"><c:out value="${shop.statusLabel}" /></span></div><c:forEach var="item" items="${shop.items}"><div class="order-card-line"><div><strong><c:out value="${item.name}" /></strong><p><c:out value="${item.color}" /> · Size <c:out value="${item.size}" /> · Số lượng: ${item.quantity}</p><p>Đơn giá: <fmt:formatNumber value="${item.price}" />đ</p><%@ include file="review-link.jspf" %></div><span><fmt:formatNumber value="${item.subtotal}" />đ</span></div></c:forEach></c:forEach></section>
<c:if test="${not empty order.voucherCode}"><p>Mã đã áp dụng: <strong><c:out value="${order.voucherCode}" /></strong> · Đã giảm <fmt:formatNumber value="${order.discount}" />đ khi đặt hàng.</p></c:if>
<div class="order-detail-total"><p><span>Phí giao hàng</span><span>Miễn phí</span></p><p><span>Tổng thanh toán</span><strong><fmt:formatNumber value="${order.total}" />đ</strong></p></div>
