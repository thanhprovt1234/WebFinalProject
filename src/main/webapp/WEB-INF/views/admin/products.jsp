<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Sản phẩm & tồn kho" />
<%@ include file="start.jspf" %>
<div class="admin-toolbar"><a class="admin-button" href="${pageContext.request.contextPath}/admin/products/new">+ Thêm sản phẩm</a><form method="get" class="admin-search"><input name="q" value="<c:out value='${query}' />" placeholder="Tìm sản phẩm" aria-label="Tìm sản phẩm"><select name="shopId" aria-label="Lọc theo shop"><option value="">Tất cả shop</option><c:forEach var="s" items="${shops}"><option value="${s.id}" ${selectedShop == s.id ? 'selected' : ''}><c:out value="${s.name}" /></option></c:forEach></select><button type="submit">Lọc</button></form></div>
<div class="admin-table"><table><thead><tr><th>Sản phẩm</th><th>Shop / Danh mục</th><th>Giá</th><th>Hiển thị</th><th>Thao tác</th></tr></thead><tbody><c:forEach var="p" items="${productsPage.content}"><tr><td><strong><c:out value="${p.name}" /></strong><small><c:out value="${p.slug}" /></small></td><td><c:out value="${p.shop}" /><small><c:out value="${p.category}" /></small></td><td><fmt:formatNumber value="${p.price}" />đ</td><td>${p.enabled ? 'Đang bật' : 'Đã xóa / ẩn'}</td><td><div class="admin-actions"><a href="${pageContext.request.contextPath}/admin/products/${p.id}/edit">Sửa / Size / Tồn kho</a><form method="post" action="${pageContext.request.contextPath}/admin/products/${p.id}/delete" data-confirm="Xóa sản phẩm khỏi danh mục bán hàng? Lịch sử đơn vẫn được giữ lại."><%@ include file="csrf.jspf" %><button type="submit" class="admin-danger">Xóa</button></form></div></td></tr></c:forEach></tbody></table></div>
<nav class="admin-pagination" aria-label="Phân trang"><c:if test="${productsPage.hasPrevious()}"><c:url var="prev" value="/admin/products"><c:param name="q" value="${query}"/><c:param name="shopId" value="${selectedShop}"/><c:param name="page" value="${productsPage.number-1}"/></c:url><a href="${prev}">← Trước</a></c:if><span>Trang ${productsPage.number+1} / ${productsPage.totalPages == 0 ? 1 : productsPage.totalPages}</span><c:if test="${productsPage.hasNext()}"><c:url var="next" value="/admin/products"><c:param name="q" value="${query}"/><c:param name="shopId" value="${selectedShop}"/><c:param name="page" value="${productsPage.number+1}"/></c:url><a href="${next}">Sau →</a></c:if></nav>
<%@ include file="end.jspf" %>
