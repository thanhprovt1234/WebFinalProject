<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Thông tin sản phẩm" />
<%@ include file="start.jspf" %>
<form class="admin-panel admin-form" method="post" action="${pageContext.request.contextPath}/admin/products${empty entityId ? '' : '/'.concat(entityId)}"><%@ include file="csrf.jspf" %>
<label>Tên sản phẩm<input name="name" maxlength="200" value="<c:out value='${form.name}' />" required></label><label>Đường dẫn sản phẩm<input name="slug" maxlength="200" pattern="[a-z0-9]+(-[a-z0-9]+)*" value="<c:out value='${form.slug}' />" required ${not empty entityId ? 'readonly' : ''}></label>
<label>Shop<select name="shopId" required><option value="">Chọn shop</option><c:forEach var="s" items="${shops}"><option value="${s.id}" ${form.shopId == s.id ? 'selected' : ''} ${not empty entityId && form.shopId != s.id ? 'disabled' : ''}><c:out value="${s.name}" /></option></c:forEach></select></label>
<label>Danh mục<select name="categoryId" required><option value="">Chọn danh mục</option><c:forEach var="c" items="${categories}"><option value="${c.id}" ${form.categoryId == c.id ? 'selected' : ''}><c:out value="${c.name}" /> ${c.enabled ? '' : '(đang tắt)'}</option></c:forEach></select></label>
<label>Giá bán (VNĐ)<input type="number" name="price" min="0" step="0.01" value="${form.price}" required></label><label>Ảnh (đường dẫn /images/… hoặc URL HTTPS)<input name="image" maxlength="2048" value="<c:out value='${form.image}' />" required></label><label>Mô tả<textarea name="description" maxlength="4000" rows="4"><c:out value="${form.description}" /></textarea></label><label class="admin-check"><input type="checkbox" name="enabled" value="true" ${form.enabled ? 'checked' : ''}> Hiển thị và cho phép bán</label><button class="admin-button" type="submit">Lưu sản phẩm</button></form>
<c:if test="${not empty entityId}"><section id="variants"><h2>Size, màu &amp; giá phiên bản</h2><p>Giá phiên bản để trống sẽ dùng giá bán của sản phẩm. Tắt phiên bản để ngừng bán size/màu đó.</p>
<c:forEach var="v" items="${options}"><form class="admin-panel admin-inline-form" method="post" action="${pageContext.request.contextPath}/admin/products/${entityId}/variants/${v.id}"><%@ include file="csrf.jspf" %><label>SKU<input name="sku" value="<c:out value='${v.sku}' />" readonly></label><label>Size<input name="size" value="<c:out value='${v.size}' />" readonly></label><label>Màu<input name="color" value="<c:out value='${v.color}' />" readonly></label><label>Giá riêng<input name="price" type="number" min="0" step="0.01" value="${v.price}"></label><label class="admin-check"><input name="enabled" type="checkbox" value="true" ${v.enabled ? 'checked' : ''}> Bán</label><button type="submit">Lưu</button></form></c:forEach>
<form class="admin-panel admin-inline-form" method="post" action="${pageContext.request.contextPath}/admin/products/${entityId}/variants"><%@ include file="csrf.jspf" %><h3>Thêm phiên bản</h3><label>SKU duy nhất<input name="sku" maxlength="64" required></label><label>Size<input name="size" maxlength="10" required></label><label>Màu<input name="color" maxlength="50" required></label><label>Giá riêng<input name="price" type="number" min="0" step="0.01"></label><input type="hidden" name="enabled" value="true"><button class="admin-button" type="submit">Thêm size/màu</button></form></section>
<section id="stock"><h2>Tồn kho theo chi nhánh</h2><p>Nhập số lượng tồn kho mới. Chỉ các chi nhánh cùng shop được chọn.</p><c:if test="${empty branches}"><p>Shop chưa có chi nhánh. <a href="${pageContext.request.contextPath}/admin/shops/${shopId}/edit">Thêm chi nhánh</a> trước khi nhập kho.</p></c:if>
<div class="admin-table"><table><thead><tr><th>SKU</th><th>Chi nhánh</th><th>Số lượng</th></tr></thead><tbody><c:forEach var="i" items="${stock}"><tr><td><c:out value="${i.sku}" /></td><td><c:out value="${i.store}" /></td><td>${i.quantity}</td></tr></c:forEach></tbody></table></div>
<form class="admin-panel admin-inline-form" method="post" action="${pageContext.request.contextPath}/admin/products/${entityId}/stock"><%@ include file="csrf.jspf" %><label>Phiên bản<select name="variantId" required><c:forEach var="v" items="${options}"><option value="${v.id}"><c:out value="${v.sku}" /> · <c:out value="${v.size}" /> · <c:out value="${v.color}" /></option></c:forEach></select></label><label>Chi nhánh<select name="storeId" required><c:forEach var="s" items="${branches}"><option value="${s.id}"><c:out value="${s.name}" /> ${s.enabled ? '' : '(đang tắt)'}</option></c:forEach></select></label><label>Tồn kho mới<input name="quantity" type="number" min="0" max="1000000" step="1" required></label><button class="admin-button" type="submit">Cập nhật tồn kho</button></form></section></c:if>
<%@ include file="end.jspf" %>
