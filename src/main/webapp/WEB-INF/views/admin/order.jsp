<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Xử lý đơn hàng" />
<%@ include file="start.jspf" %>
<div class="admin-panel"><h2>Đơn shop #${shopOrder.id} — <c:out value="${shopOrder.shop}" /></h2><p>Trạng thái: <strong><c:out value="${shopOrder.statusLabel}" /></strong></p><p>Thay đổi dưới đây áp dụng cho phần đơn của shop này.</p>
<c:if test="${not empty nextStatuses}"><form method="post" action="${pageContext.request.contextPath}${ordersBase}/${shopOrder.id}/status" class="admin-form"><%@ include file="csrf.jspf" %><label>Chuyển trạng thái<select name="status" required><c:forEach var="s" items="${nextStatuses}"><option value="${s}"><c:choose><c:when test="${s == 'CONFIRMED'}">Xác nhận đơn</c:when><c:when test="${s == 'CANCELLED'}">Từ chối / Hủy đơn &amp; hoàn tồn kho</c:when><c:otherwise>${s}</c:otherwise></c:choose></option></c:forEach></select></label><label>Ghi chú (bắt buộc khi hủy đơn)<textarea name="note" maxlength="1800" rows="3"></textarea></label><button class="admin-button" type="submit">Lưu trạng thái</button></form></c:if></div>
<c:if test="${returnToStock}"><p class="alert alert-warning">Chỉ chọn hủy đơn sau khi đã nhận đủ hàng hoàn từ shipper. Thao tác sẽ hoàn tồn kho và đóng đơn giao.</p></c:if>
<c:if test="${not sellerOrders}"><div class="admin-panel"><h2>Phân công giao hàng</h2>
<c:choose><c:when test="${not empty assignedShipment}"><p>Shipper: <strong><c:out value="${assignedShipment.shipper}" /></strong> · <c:out value="${assignedShipment.label}" /></p><p>Phân công lúc <c:out value="${assignedShipment.assignedAt}" /></p><c:if test="${not empty assignedShipment.failureReason}"><p>Lý do giao chưa thành công: <c:out value="${assignedShipment.failureReason}" /></p></c:if><a href="${pageContext.request.contextPath}/shipper/shipments/${assignedShipment.id}">Xem tiến trình giao hàng</a></c:when>
<c:when test="${canAssign}"><c:choose><c:when test="${empty shippers}"><p>Chưa có tài khoản shipper đang hoạt động. Cấp vai trò Shipper trong trang tài khoản trước.</p></c:when><c:otherwise><form class="admin-form" method="post" action="${pageContext.request.contextPath}/admin/orders/${shopOrder.id}/assign"><%@ include file="csrf.jspf" %><label>Shipper<select name="shipperId" required><option value="">Chọn người giao hàng</option><c:forEach var="s" items="${shippers}"><option value="${s.id}"><c:out value="${s.name}" /></option></c:forEach></select></label><button class="admin-button" type="submit">Phân công giao hàng</button></form></c:otherwise></c:choose></c:when>
<c:otherwise><p>Phân công được mở sau khi đơn được xác nhận.</p></c:otherwise></c:choose></div></c:if>
<div class="admin-panel"><h2>Đối soát tiền COD</h2><p><strong><c:out value="${codSettlement.label}" /></strong></p>
<c:if test="${codSettlement.amount > 0}"><p>COD shipper đã thu từ khách: <strong><fmt:formatNumber value="${codSettlement.amount}" />đ</strong></p></c:if>
<c:if test="${not empty codSettlement.remittedAt}"><p>Shipper ghi nhận bàn giao lúc: <c:out value="${codSettlement.remittedAt}" /></p><p><c:out value="${codSettlement.remittanceNote}" /></p></c:if>
<c:if test="${codSettlement.state == 'COLLECTED'}"><p>Chờ shipper bàn giao tiền và gửi xác nhận. Trạng thái khách đã thanh toán không có nghĩa shop đã nhận tiền.</p></c:if>
<c:if test="${codSettlement.state == 'REMITTED'}"><form class="admin-form" method="post" action="${pageContext.request.contextPath}${ordersBase}/${shopOrder.id}/cod/confirm"><%@ include file="csrf.jspf" %><input type="hidden" name="amount" value="${codSettlement.amount}"><label>Ghi chú nhận tiền<textarea name="note" maxlength="500" rows="3"></textarea></label><label><input type="checkbox" name="confirmed" value="true" required> Tôi đã kiểm tra và thực nhận đủ <fmt:formatNumber value="${codSettlement.amount}" />đ COD</label><button class="admin-button" type="submit">Xác nhận shop đã nhận đủ COD</button></form></c:if>
<c:if test="${not empty codSettlement.confirmedAt}"><p>Đã xác nhận nhận tiền lúc: <c:out value="${codSettlement.confirmedAt}" /> · <c:out value="${codSettlement.confirmedBy}" /></p><p><c:out value="${codSettlement.confirmationNote}" /></p></c:if>
</div>
<div class="admin-panel"><h2>Thông tin đơn của khách</h2><%@ include file="../checkout/details.jspf" %></div>
<div class="admin-panel"><h2>Lịch sử xử lý phần đơn</h2><c:forEach var="e" items="${events}"><p><strong><c:out value="${e.status}" /></strong> · <c:out value="${e.time}" /><br><c:out value="${e.note}" /></p></c:forEach></div>
<%@ include file="end.jspf" %>
