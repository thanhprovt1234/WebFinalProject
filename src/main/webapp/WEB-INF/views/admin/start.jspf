<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="bodyClass" value="admin-page" />
<%@ include file="../fragments/header.jspf" %>
<fmt:setLocale value="vi_VN" />
<c:if test="${empty ordersBase}"><c:set var="ordersBase" value="/admin/orders" /></c:if>
<section class="admin-shell">
<div class="admin-heading"><div><span>${sellerOrders ? 'QUẢN LÝ ĐƠN HÀNG SHOP' : 'H2T · QUẢN TRỊ HỆ THỐNG'}</span><h1><c:out value="${pageTitle}" /></h1></div><a href="${pageContext.request.contextPath}/workspace">Khu vực làm việc ↗</a></div>
<c:choose><c:when test="${sellerOrders}"><nav class="admin-nav"><a href="${pageContext.request.contextPath}/seller">Shop của bạn</a><a href="${pageContext.request.contextPath}/seller/orders">Đơn hàng của shop</a></nav></c:when><c:otherwise><nav class="admin-nav" aria-label="Quản trị"><a href="${pageContext.request.contextPath}/admin">Tổng quan</a><a href="${pageContext.request.contextPath}/admin/shops">Shop &amp; chi nhánh</a><a href="${pageContext.request.contextPath}/admin/products">Sản phẩm &amp; tồn kho</a><a href="${pageContext.request.contextPath}/admin/categories">Danh mục</a><a href="${pageContext.request.contextPath}/admin/orders">Duyệt đơn hàng</a><a href="${pageContext.request.contextPath}/admin/users">Tài khoản &amp; phân quyền</a></nav></c:otherwise></c:choose>
<c:if test="${not empty success}"><p class="alert alert-success" role="status"><c:out value="${success}" /></p></c:if>
<c:if test="${not empty error}"><p class="alert alert-danger" role="alert"><c:out value="${error}" /></p></c:if>
