<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="bodyClass" value="profile-page" />
<%@ include file="../fragments/header.jspf" %>
<link href="${pageContext.request.contextPath}/css/shipper.css" rel="stylesheet">
<fmt:setLocale value="vi_VN" />
<main class="shipper-shell">
<nav class="activity-nav"><a href="${pageContext.request.contextPath}/workspace">Khu vực làm việc</a><a href="${pageContext.request.contextPath}/shipper">Đơn được phân công</a><a href="${pageContext.request.contextPath}/shipper/statistics">Thống kê giao hàng</a></nav>
<c:if test="${not empty success}"><p class="alert alert-success" role="status"><c:out value="${success}" /></p></c:if>
<c:if test="${not empty error}"><p class="alert alert-danger" role="alert"><c:out value="${error}" /></p></c:if>
