<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Chi tiết giao hàng" />
<%@ include file="start.jspf" %>
<header class="shipper-heading"><span>ĐƠN GIAO #${shipment.id}</span><h1>Đơn shop #${shipment.orderId}</h1><span class="shipper-badge" data-status="${shipment.status}"><c:out value="${shipment.label}" /></span></header>
<div class="shipper-detail-grid"><section class="shipper-panel"><h2>Thông tin nhận hàng</h2><h3><c:out value="${shipment.shop}" /></h3><c:forEach var="p" items="${pickup}"><p><c:out value="${p}" /></p></c:forEach><c:if test="${empty pickup}"><p>Liên hệ shop để xác nhận địa điểm lấy hàng.</p></c:if><c:if test="${not empty shopPhone}"><p>Điện thoại shop: <c:out value="${shopPhone}" /></p></c:if><ul><c:forEach var="i" items="${items}"><li><c:out value="${i.name}" /> · <c:out value="${i.color}" /> · Size <c:out value="${i.size}" /> · SL ${i.quantity}</li></c:forEach></ul></section>
<section class="shipper-panel"><h2>Người nhận</h2><h3><c:out value="${shipment.receiver}" /></h3><p><c:out value="${shipment.phone}" /></p><p><c:out value="${shipment.address}" /></p><c:url var="map" value="https://www.google.com/maps/search/"><c:param name="api" value="1"/><c:param name="query" value="${shipment.address}"/></c:url><div class="shipper-shortcuts"><a href="tel:<c:out value='${shipment.phone}'/>">Gọi người nhận</a><a href="<c:out value='${map}'/>" target="_blank" rel="noopener noreferrer">Mở bản đồ ↗</a></div><p>Thanh toán: <c:out value="${shipment.paymentMethod}" /></p><p>Tiền COD thu hộ: <strong><fmt:formatNumber value="${shipment.cod}" />đ</strong></p></section></div>
<section class="shipper-panel"><h2>Cập nhật giao hàng</h2><p>Phân công: <c:out value="${shipment.assignedAt}" /> · Shipper: <c:out value="${shipment.shipper}" /></p><c:if test="${not empty shipment.pickedUpAt}"><p>Đã nhận hàng: <c:out value="${shipment.pickedUpAt}" /></p></c:if><c:if test="${not empty shipment.deliveredAt}"><p>Đã giao: <c:out value="${shipment.deliveredAt}" /></p></c:if><c:if test="${not empty shipment.failureReason}"><p>Lý do giao chưa thành công gần nhất: <c:out value="${shipment.failureReason}" /></p></c:if>
<c:if test="${shipment.status != 'DELIVERED' and shipment.status != 'CANCELLED'}"><form method="post" action="${pageContext.request.contextPath}/shipper/shipments/${shipment.id}/status" class="shipper-update"><%@ include file="../admin/csrf.jspf" %><label>Thao tác<select name="status" required><c:choose><c:when test="${shipment.status == 'ASSIGNED'}"><option value="PICKED_UP">Đã nhận đủ hàng từ shop</option></c:when><c:when test="${shipment.status == 'PICKED_UP'}"><option value="SHIPPING">Bắt đầu giao</option></c:when><c:when test="${shipment.status == 'FAILED'}"><option value="SHIPPING">Giao lại</option></c:when><c:when test="${shipment.status == 'SHIPPING'}"><option value="DELIVERED">Giao thành công</option><option value="FAILED">Giao chưa thành công</option></c:when></c:choose></select></label><label>Ghi chú / Lý do (bắt buộc khi giao chưa thành công)<textarea name="note" maxlength="1000" rows="3"></textarea></label><c:if test="${shipment.status == 'SHIPPING' and shipment.cod > 0}"><label class="shipper-checkbox"><input type="checkbox" name="codCollected" value="true"> Tôi đã thu đủ <fmt:formatNumber value="${shipment.cod}" />đ COD (khi giao thành công)</label></c:if><button type="submit">Cập nhật tiến trình</button></form></c:if>
<c:if test="${shipment.status == 'FAILED'}"><p>Có thể giao lại khi khách hẹn lại. Nếu hoàn hàng, bàn giao hàng cho shop và liên hệ Admin xác nhận nhận hoàn.</p></c:if></section>
<section class="shipper-panel"><h2>Bàn giao COD cho shop</h2><p><strong><c:out value="${shipment.settlement.label}" /></strong></p>
<c:if test="${shipment.settlement.amount > 0}"><p>Số tiền đối soát: <strong><fmt:formatNumber value="${shipment.settlement.amount}" />đ</strong></p></c:if>
<c:if test="${not empty shipment.settlement.remittedAt}"><p>Shipper ghi nhận bàn giao lúc: <c:out value="${shipment.settlement.remittedAt}" /></p><p><c:out value="${shipment.settlement.remittanceNote}" /></p></c:if>
<c:if test="${not empty shipment.settlement.confirmedAt}"><p>Shop xác nhận lúc: <c:out value="${shipment.settlement.confirmedAt}" /> · <c:out value="${shipment.settlement.confirmedBy}" /></p><p><c:out value="${shipment.settlement.confirmationNote}" /></p></c:if>
<c:if test="${shipment.settlement.state == 'COLLECTED'}"><p>Bàn giao đủ tiền cho shop bằng tiền mặt hoặc chuyển khoản, sau đó ghi nhận tại đây để shop kiểm tra và xác nhận.</p><form class="shipper-update" method="post" action="${pageContext.request.contextPath}/shipper/shipments/${shipment.id}/cod/remit"><%@ include file="../admin/csrf.jspf" %><input type="hidden" name="amount" value="${shipment.settlement.amount}"><label>Ghi chú bàn giao / Mã giao dịch<textarea name="note" maxlength="500" rows="3"></textarea></label><label class="shipper-checkbox"><input type="checkbox" name="confirmed" value="true" required> Tôi đã bàn giao đủ <fmt:formatNumber value="${shipment.settlement.amount}" />đ cho shop</label><button type="submit">Đã bàn giao COD · Gửi shop xác nhận</button></form></c:if>
</section>
<section class="shipper-panel"><h2>Lịch sử xử lý</h2><c:forEach var="e" items="${events}"><div class="shipper-event"><strong><c:out value="${e.time}" /></strong><p><c:out value="${e.note}" /></p></div></c:forEach></section>
</main><%@ include file="../fragments/footer.jspf" %>
