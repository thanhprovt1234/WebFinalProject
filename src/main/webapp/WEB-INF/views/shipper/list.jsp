<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Đơn giao và thống kê" />
<%@ include file="start.jspf" %>
<header class="shipper-heading"><span>H2T · GIAO HÀNG</span><h1>${statistics ? 'Thống kê giao hàng' : 'Đơn được phân công'}</h1><p>Theo dõi đơn, cập nhật tiến trình và kiểm tra tiền thu hộ.</p></header>
<form class="shipper-filters" method="get">
<label>Từ ngày phân công<input type="date" name="from" value="${from}"></label><label>Đến ngày<input type="date" name="to" value="${to}"></label>
<c:if test="${not statistics}"><label>Tìm đơn<input name="q" maxlength="150" value="<c:out value='${query}'/>" placeholder="Mã đơn shop, tên, SĐT"></label><label>Trạng thái<select name="status"><option value="">Tất cả</option><c:forEach var="s" items="${statuses}"><option value="${s}" ${selectedStatus == s ? 'selected' : ''}><c:choose><c:when test="${s == 'ASSIGNED'}">Chờ lấy hàng</c:when><c:when test="${s == 'PICKED_UP'}">Đã nhận hàng</c:when><c:when test="${s == 'SHIPPING'}">Đang giao</c:when><c:when test="${s == 'FAILED'}">Giao chưa thành công</c:when><c:when test="${s == 'DELIVERED'}">Giao thành công</c:when><c:otherwise>Đã hủy / hoàn hàng</c:otherwise></c:choose></option></c:forEach></select></label></c:if>
<button type="submit">Áp dụng</button></form>
<div class="shipper-shortcuts"><a href="?from=${today}&amp;to=${today}">Hôm nay</a><a href="?from=${monthStart}&amp;to=${today}">Tháng này</a><a href="${pageContext.request.contextPath}/shipper">Tất cả đơn</a></div>
<div class="shipper-metrics"><article><span>Tổng được phân công</span><strong>${total}</strong></article><article><span>Chờ lấy hàng</span><strong>${counts.ASSIGNED}</strong></article><article><span>Đã nhận hàng</span><strong>${counts.PICKED_UP}</strong></article><article><span>Đang giao</span><strong>${counts.SHIPPING}</strong></article><article><span>Giao thành công</span><strong>${counts.DELIVERED}</strong></article><article><span>Giao chưa thành công</span><strong>${counts.FAILED}</strong></article><article><span>Đã hủy / hoàn hàng</span><strong>${counts.CANCELLED}</strong></article><article><span>Tỷ lệ giao thành công</span><strong>${rate}%</strong></article><article><span>COD đã thu hộ</span><strong><fmt:formatNumber value="${collected}" />đ</strong></article></div>
<div class="shipper-metrics"><article><span>COD chờ bàn giao cho shop</span><strong><fmt:formatNumber value="${unremitted}" />đ</strong></article><article><span>Đã bàn giao · Chờ shop xác nhận</span><strong><fmt:formatNumber value="${awaitingConfirmation}" />đ</strong></article><article><span>Shop đã xác nhận nhận COD</span><strong><fmt:formatNumber value="${confirmedCod}" />đ</strong></article></div>
<p class="text-muted">Số liệu tính trên các đơn được phân công trong khoảng ngày đã chọn, theo trạng thái hiện tại. COD là tiền thu hộ, không phải thu nhập. Đối soát tính theo số COD thực thu đã lưu.</p>
<c:choose><c:when test="${statistics}"><section class="shipper-panel"><h2>Kết quả theo ngày phân công</h2><c:if test="${empty daily}"><p>Chưa có đơn được phân công trong khoảng ngày này.</p></c:if><c:forEach var="d" items="${daily}"><div class="shipper-day"><strong>${d.day}</strong><span>${d.delivered} / ${d.assigned} đơn giao thành công</span><progress max="100" value="${d.percent}" aria-label="Tỷ lệ giao thành công ngày ${d.day}">${d.percent}%</progress></div></c:forEach></section></c:when>
<c:otherwise><h2>Danh sách đơn (${filteredTotal})</h2><c:if test="${empty rows}"><section class="shipper-panel">Chưa có đơn phù hợp với bộ lọc.</section></c:if><div class="shipper-orders"><c:forEach var="s" items="${rows}"><article class="shipper-panel"><div class="shipper-order-heading"><h2>Đơn shop #${s.orderId}</h2><span class="shipper-badge" data-status="${s.status}"><c:out value="${s.label}" /></span></div><p><strong><c:out value="${s.shop}" /></strong> · Đơn khách #${s.parentId}</p><p><c:out value="${s.receiver}" /> · <c:out value="${s.phone}" /></p><p><c:out value="${s.address}" /></p><p>COD: <strong><fmt:formatNumber value="${s.cod}" />đ</strong> · Phân công <c:out value="${s.assignedAt}" /></p><p><c:out value="${s.settlement.label}" /></p><a class="shipper-link" href="${pageContext.request.contextPath}/shipper/shipments/${s.id}">Xem chi tiết →</a></article></c:forEach></div>
<nav class="shipper-pagination" aria-label="Phân trang"><c:if test="${page > 0}"><c:url var="prev" value="/shipper"><c:param name="page" value="${page - 1}"/><c:param name="q" value="${query}"/><c:param name="status" value="${selectedStatus}"/><c:param name="from" value="${from}"/><c:param name="to" value="${to}"/></c:url><a href="<c:out value='${prev}'/>">← Trang trước</a></c:if><span>Trang ${page + 1} / ${pages}</span><c:if test="${page + 1 < pages}"><c:url var="next" value="/shipper"><c:param name="page" value="${page + 1}"/><c:param name="q" value="${query}"/><c:param name="status" value="${selectedStatus}"/><c:param name="from" value="${from}"/><c:param name="to" value="${to}"/></c:url><a href="<c:out value='${next}'/>">Trang sau →</a></c:if></nav>
</c:otherwise></c:choose>
</main><%@ include file="../fragments/footer.jspf" %>
