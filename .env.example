# Docker Compose reads .env. Never commit real values.
# Required: choose your own passwords. SQL Server needs >= 8 characters,
# with at least 3 of uppercase, lowercase, digits, symbols.
MSSQL_SA_PASSWORD=
ADMIN_SEED_PASSWORD=
DB_NAME=H2T_DB
APP_HOST_PORT=8080
# Use 1434 if Windows SQL Server already occupies port 1433.
DB_HOST_PORT=1433

# Optional: needed only for sending password-reset emails.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Direct Windows execution only; Spring Boot does not read .env itself.
# Docker overrides the datasource with sa + MSSQL_SA_PASSWORD.
DB_URL=
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
